<?xml version="1.0" encoding="utf-8"?>
<!-- Conteúdo da tela Cardápio -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="80dp"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <!-- lista de datas disponíveis no site -->
    <Spinner
        android:id="@+id/spinnerDatasXML"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp" />

    <!-- aparece enquanto baixa o cardápio -->
    <ProgressBar
        android:id="@+id/progressXML"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/cardapioXML"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="@string/cardapio_carregando" />
    </ScrollView>
</LinearLayout>
